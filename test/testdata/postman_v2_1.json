{
	"info": {
		"name": "Test Collection",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Root Request",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "https://api.example.com/data",
					"host": [
						"api",
						"example",
						"com"
					],
					"path": [
						"data"
					]
				}
			},
			"response": []
		},
		{
			"name": "Folder A",
			"item": [
				{
					"name": "Nested Request 1",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer token123"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"key\": \"value\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "https://api.example.com/users"
					},
					"response": []
				},
				{
					"name": "SubFolder B",
					"item": [
						{
							"name": "Deeply Nested Request",
							"request": {
								"method": "PUT",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/xml"
